// Program Example

I32_MAX := 2147483647;
I32_MIN := -2147483648;

fn is_sign(c: byte) -> bool {
    return c == '+' || c == '-'
}

fn is_digit(c: byte) -> bool {
    return c >= '0' && c <= '9';
}

fn is_decimal(str: byte*) -> bool {
    i: usize = 0;

    //Optional sign
    if is_sign(str[i]) { i += 1; }
    
    //Whole digits
    whole := false;
    while is_decimal(str[i]) {
        whole = true;
        i += 1;
    }

    //Decimal point
    dot := false
    if str[i] == '.' {
        dot = true;
        i += 1
    }

    //Fractional digits
    fraction := false;
    while is_decimal(str[i]) {
        fraction = true;
        i += 1;
    }
    
    //Check if whole string was consumed
    if str[i] != '\0' { return false; }

    return whole || (dot && fraction);
}

fn parse_float(str: byte*) -> float {

    negative := false;
    if str[0] == '+' {
        str += 1;
    }
    else if str[0] == '-' {
        negative = true;
        str += 1;
    }

    dot_idx: usize = 0;
    len: usize = 0;
   
    //Find the decimal point
    while str[len] != '\0' {
        if str[len] == '.' {
            dot_idx = len;
            len += 1;
            break;
        }
        len += 1;
    }

    //Get string len
    while str[len] != '\0' { len += 1; }

    whole_digits := dot_idx;
    fractional_digits := len - dot_idx - 1;

    float := 0.0;
    mult := 1.0;

    // Whole digits
    if (dot_idx != 0) { 
        for i: usize = 1; i <= dot_idx; i += 1 {
            float += (src[dot_idx-i] - '0') as f32 * mult;
            mult *= 10;
        }
    }

    // Fractional digits
    mult = 0.1;
    for i: usize = dot_idx + 1; i < len; i += 1 {
        float += (str[i] - '0') as f32 * mult;
        mult /= 10;
    }

    if negative { float = -float; }
    
    return float;
}

fn is_i32(str: byte*) -> bool {
    i: usize = 0;

    //Optional sign
    if is_sign(str[i]) { i += 1; }

    //Required digit
    if is_digit(str[i]) { i += 1; }
    else { return false; }

    //Remaining optional digits
    while is_digit(str[i]) { i += 1; }

    return str[i] == '\0';
}

fn parse_i32(str: byte*) -> i32 {
    mult := 1;
    if str[0] == '+' {
        str += 1;
    }
    else if str[0] == '-' {
        mult = -1;
        str += 1;
    }
   
    len := 0;
    while str[i] != '\0' { len += 1; }
    if len > 10 {
         if mult == 1 { return I32_MAX; }
         if mult == -1 { return I32_MIN; }
    }

    int := 0;
    for i := len-1; i >= 0; i -= 1 {
        part := (str[i] - '\0') as i32 * mult;
        if mult == 1 {
            if int > I32_MAX - part {
                return I32_MAX;
            }
        }
        else if mult == -1 {
            if int < I32_MIN - part {
                return I32_MIN;
            }
        }
        int += part;
        mult *= 10;
    }

    return int;
}

fn pow(a: f32, b: i32) -> f32 {
    acc := 1.0;
    if (b > 0) {
        for i := 0; i < b; i += 1 { acc *= a; }
    }
    else if (b < 0) {
        inv := 1.0 / a;
        for i := 0; i > b; i -= 1 { acc *= inv; }
    }
    return acc;
}

fn main() {
    input: byte[128];
    bytes_read: usize;
    
    __write__ "Enter a base";
    loop {
        bytes_read = __read__ input, 127;
        str[bytes_read] = '\0'
        if is_decimal(input) { break; }
        __write__ "Please enter a real number\n";
    }
    a := parse_float(input);
    
    __write__ "Enter an exponent\n"
    loop {
        bytes_read = __read__ input, 127;
        str[bytes_read] = '\0'
        if is_i32(input) { break; }
        __write__ "Please enter a whole number\n";
    }
    b := parse_i32(input);

    c := pow(a,b);
    __write__ a;
    __write__ " to the ";
    __write__ b;
    __write__ " is ";
    __write__ c;
    __write__ "\n";

    return;
}
